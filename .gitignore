# =========================================================
# 1. CMake/Build System Files (通用)
# =========================================================
# 忽略所有构建目录，通常命名为 'build' 或 'out'
# 如果你的构建目录不是 'build'，请修改或添加
/build/
/Build/


# CMake生成的中间文件和缓存
/CMakeFiles/
CMakeCache.txt
CTestTestfile.cmake
Makefile
cmake_install.cmake
install_manifest.txt
compile_commands.json  # 如果开启了 CMAKE_EXPORT_COMPILE_COMMANDS

# Windows Visual Studio 相关文件
*.vcxproj
*.sln
*.user
*.filters
*.dir

# 临时文件和备份
*~
*.bak
*.swp
*.orig

# =========================================================
# 2. 特定于嵌入式项目和工具链的文件 (您的项目相关)
# =========================================================
# 可执行文件 (ELF, BIN, HEX)
*.elf
*.bin
*.hex

# 链接器生成的内存映射文件
*.map

# J-Link / ST-Link 等调试工具的日志或设置文件
*.jlink
*.cfg
*.log

# =========================================================
# 3. IDE / 编辑器特定文件
# =========================================================
# Visual Studio Code
.vscode/

# CLion / JetBrains IDEs
.idea/

# Eclipse
.project
.cproject
.settings/

# Qt Creator
*.pro.user